<header class="header">
  <div class="header-top">
    <div class="container">
      <div class="header-top__inner">
        <button
          class="c-header__opener js-header__opener d-lg-none d-flex"
          type="button"
        >
          <span></span>
          MENU
        </button>
        <div class="header-top__item d-lg-block d-none">
          <img
            class="object-fit-contain"
            width="220"
            height="32"
            src="images/ico/vsetin.svg"
            alt="VHK ROBE VSETÍN"
          />
        </div>
        <a href="/" class="header__logo d-lg-none d-block" aria-label="home">
          <img src="images/ico/logo.svg" alt="VHK Vsetín" />
        </a>
        <div class="header-top__item d-lg-block d-none">
          <img
            class="object-fit-contain"
            width="190"
            height="32"
            src="images/ico/spoluvsetin.svg"
            alt="#spoluzavsetin"
          />
        </div>
        <button class="js-header__fanzone c-header__opener d-lg-none d-flex">
          FANZÓNA
          <img
            src="images/ico/fanzone.svg"
            width="20"
            height="19"
            class="object-fit-contain"
            alt="fanzone"
          />
        </button>
      </div>
    </div>
  </div>

  <div class="header-main">
    <div class="container">
      <div class="header-main__inner">
        <div class="header-main__fanzone">
          <div class="pe-lg-22 header-main__menu">
            <a class="header-main__link" href="#">
              <img
                class="object-fit-contain"
                src="images/ico/ticket.svg"
                width="24"
                height="24"
                alt="vstupenky"
              />
              Koupit vstupenky
            </a>
            <a class="header-main__link" href="#">
              <img
                class="object-fit-contain"
                src="images/ico/cart.svg"
                width="24"
                height="24"
                alt="Fanshop"
              />
              Fanshop VHK
            </a>
          </div>
          <a href="/" class="header__logo d-lg-block d-none" aria-label="home">
            <img src="images/ico/logo.svg" alt="VHK Vsetín" />
          </a>

          <div class="ps-lg-22 header-main__menu">
            <a class="header-main__link" href="#">
              <img
                class="object-fit-contain"
                src="images/ico/mobile.svg"
                width="24"
                height="24"
                alt="Mobilní aplikace"
              />
              Mobilní aplikace
            </a>
            <a class="header-main__link" href="#">
              <img
                class="object-fit-contain"
                src="images/ico/list.svg"
                width="24"
                height="24"
                alt="Fenomen Vsetín"
              />
              Fenomen Vsetín
            </a>
          </div>
        </div>
        <a class="header-main__link d-lg-none" href="#">
          <img
            class="object-fit-contain"
            src="images/ico/ticket.svg"
            width="24"
            height="24"
            alt="vstupenky"
          />
          Koupit vstupenky
        </a>
      </div>
    </div>
  </div>
</header>

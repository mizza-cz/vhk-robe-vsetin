        <h2>DEVELOPMENT PROGRAM</h2>
        <p>
          Development tvoří nadstavbovou činnost, vedle pevného týmového
          programu jednotlivých mládežnických kategorií. Development programy
          jsou dobrovolným doplňkem ke standardní klubové činnosti a jsou určeny
          hráčům a hráčkám jak VHK, tak i okolních klubů.
        </p>
      </div>
      <div class="row g-8 my-8">
        <div class="col-md-6">
          <div
            class="border-1 p-4 d-flex flex-column justify-content-between gap-6 h-100 bg-slate-50"
          >
            <img
              class="object-fit-contain"
              src="images/ico/icodev.svg"
              width="48"
              height="48"
              loading="lazy"
              alt="ico"
            />
            <div class="h4 text-primary">
              CELOROČNÍ DEVELOPMENT PROGRAM VÝUKY HOKEJOVÝCH DOVEDNOSTÍ
              2025/2026
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div
            class="border-1 p-4 d-flex flex-column justify-content-between gap-6 h-100 bg-slate-50"
          >
            <img
              class="object-fit-contain"
              src="images/ico/icodev.svg"
              width="48"
              height="48"
              loading="lazy"
              alt="ico"
            />
            <div class="">
              <div class="h4 text-primary">
                CELOROČNÍ DEVELOPMENT PROGRAM VÝUKY HOKEJOVÝCH DOVEDNOSTÍ
                2025/2026
              </div>
              <div class="h5">24. - 27. srpna 2026</div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="border-1 p-4 d-flex flex-column justify-content-between gap-6 bg-slate-50"
      >
        <form class="form" novalidate>
          <div class="row gx-8 gy-4">
            <div class="col-xxl-6 col-lg-12 col-md-6">
              <label for="playerName" class="form-label-custom">
                Jméno a příjmení hráče/hráčky
              </label>
              <input
                type="text"
                class="form-control"
                id="playerName"
                name="playerName"
                placeholder="JMÉNO A PŘÍJMENÍ"
                autocomplete="name"
              />
            </div>

            <div class="col-xxl-6 col-lg-12 col-md-6">
              <label for="birthDate" class="form-label-custom">
                Datum narození hráče/hráčky
              </label>
              <input
                type="date"
                class="form-control"
                id="birthDate"
                name="birthDate"
                lang="cs"
              />
            </div>

            <div class="col-xxl-6 col-lg-12 col-md-6">
              <label for="address" class="form-label-custom">
                Kontaktní adresa bydliště
              </label>
              <input
                type="text"
                class="form-control"
                id="address"
                name="address"
                placeholder="ADRESA"
                autocomplete="street-address"
              />
            </div>

            <div class="col-xxl-6 col-lg-12 col-md-6">
              <label for="guardianName" class="form-label-custom">
                Zákonný zástupce hráče/hráčky
              </label>
              <input
                type="text"
                class="form-control"
                id="guardianName"
                name="guardianName"
                placeholder="JMÉNO A PŘÍJMENÍ"
                autocomplete="name"
              />
            </div>

            <div class="col-xxl-6 col-lg-12 col-md-6">
              <label for="guardianEmail" class="form-label-custom text-danger">
                Kontaktní e-mail zákonného zástupce
              </label>
              <input
                type="email"
                class="form-control is-invalid"
                id="guardianEmail"
                name="guardianEmail"
                placeholder="NESPRÁVNÁ FORMA E-MAILU"
                value=""
                aria-invalid="true"
                aria-describedby="guardianEmailError"
                autocomplete="email"
              />
            </div>

            <div class="col-xxl-6 col-lg-12 col-md-6">
              <label for="guardianPhone" class="form-label-custom">
                Kontaktní telefon zákonného zástupce
              </label>
              <input
                type="tel"
                class="form-control"
                id="guardianPhone"
                name="guardianPhone"
                placeholder="TELEFONNÍ ČÍSLO"
                autocomplete="tel"
              />
            </div>

            <div class="col-xxl-6 col-lg-12 col-md-6">
              <label for="note" class="form-label-custom">
                Místo pro vaši poznámku, vzkaz
              </label>
              <textarea
                class="form-control"
                id="note"
                name="note"
                placeholder="TEXT VZKAZU"
              ></textarea>
            </div>

            <div
              class="col-xxl-6 col-lg-12 col-md-6 d-flex flex-column gap-4 justify-content-between"
            >
              <fieldset>
                <legend class="form-section-legend mb-2">
                  Název klubu nebo týmu
                </legend>

                <div
                  class="radio-group"
                  role="radiogroup"
                  aria-label="Název klubu nebo týmu"
                >
                  <label class="form-check-custom radio">
                    <input
                      class="form-check-input"
                      type="radio"
                      name="club"
                      value="vhk-vsetin"
                      checked
                    />
                    <span class="control" aria-hidden="true"></span>
                    <span class="control-label">VHK Vsetín</span>
                  </label>

                  <label class="form-check-custom radio">
                    <input
                      class="form-check-input"
                      type="radio"
                      name="club"
                      value="other"
                    />
                    <span class="control" aria-hidden="true"></span>
                    <span class="control-label">Jiný klub</span>
                  </label>
                </div>
              </fieldset>

              <div>
                <label for="term" class="form-label-custom">Termíny</label>
                <select
                  class="js-select"
                  id="term"
                  name="term"
                  aria-label="Vyberte termíny"
                >
                  <option selected disabled>VYBERTE TERMÍNY</option>
                  <option value="term-1">Termín 1</option>
                  <option value="term-2">Termín 2</option>
                  <option value="term-3">Termín 3</option>
                </select>
              </div>
            </div>

            <div class="col-12">
              <fieldset>
                <legend class="visually-hidden">
                  Souhlas se zpracováním osobních údajů
                </legend>

                <label class="form-check-custom checkbox disabled mb-2">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="consentReadonly"
                    disabled
                  />
                  <span class="control" aria-hidden="true"></span>
                  <span class="control-label">
                    Souhlas se zpracováním těchto vašich osobních údajů
                  </span>
                </label>

                <label class="form-check-custom checkbox">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="consent"
                    checked
                    required
                  />
                  <span class="control" aria-hidden="true"></span>
                  <span class="control-label">
                    Souhlas se zpracováním těchto vašich osobních údajů
                  </span>
                </label>
              </fieldset>
            </div>

            <div class="col-12">
              <div class="submit-wrap">
                <button type="submit" class="button-primary">Odeslat</button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
    <div class="col-xl-4">
      <aside class="aside">
        <a class="d-block w-100" href="#" target="_blank">
          <img
            class="object-fit-cover"
            width="100%"
            loading="lazy"
            srcset="https://picsum.photos/400/400 216w"
            alt=""
          />
        </a>
      </aside>
    </div>
  </div>
</div>
{% endblock %}
